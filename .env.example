# ELUM Store talks to the ELUM platform on Supabase: the same project as Write, Type, Make,
# Browse and ELUM Account. Netlify builds refuse to run without these.
VITE_SUPABASE_URL=https://afdnnvngrpdodsfwpaqo.supabase.co
# The publishable (anon) key. Safe in the browser.
VITE_SUPABASE_ANON_KEY=

